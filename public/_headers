# Cabeçalhos das respostas servidas pelo roteador de assets do Worker.
#
# Fica em app/public/ e não em public/: o build do Vite apaga public/ inteiro a
# cada rodada (emptyOutDir), então um arquivo escrito lá direto some no próximo
# `npm run build`.
#
# O HTML do painel não passa pelo Worker — o roteador de assets responde antes —,
# então estes cabeçalhos são o único lugar onde dá para endurecê-lo.

/*
  # Um script injetado (dependência comprometida, extensão, XSS) só vaza o que
  # conseguir enviar para fora. `connect-src 'self'` fecha essa porta: o token
  # de webhook que o painel busca ao clicar em copiar não tem para onde ir.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'
  # O token do webhook viaja na URL (?t=). Sem isto, bastaria o painel abrir um
  # link externo para o token sair inteiro no cabeçalho Referer.
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  # Redundante com frame-ancestors, e é o que navegador antigo entende.
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # Nada aqui usa câmera, microfone ou localização; negar por escrito impede que
  # um script de terceiro peça em nome do painel.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

/index.html
  # A casca do painel nunca é cacheada: ela é o que aponta para os bundles, e uma
  # cópia velha em disco mantém a tela viva depois da sessão do Access expirar.
  Cache-Control: no-store
