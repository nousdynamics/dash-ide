{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dash-ide",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  /*
   * Sem URL *.workers.dev.
   *
   * O Cloudflare Access protege `painel.ide.edu.br`, mas não alcança
   * `dash-ide.<subdomínio>.workers.dev` — aquele hostname não está numa zona
   * nossa. Com ele ligado, qualquer pessoa com o endereço lia o investimento
   * real da conta sem passar por login. O painel responde só pelo domínio
   * próprio, que é onde o Access atua.
   */
  "workers_dev": false,
  "preview_urls": false,

  // Frontend servido pelo mesmo Worker: mesma origem das rotas /api (sem CORS) e
  // um único hostname pro Cloudflare Access proteger.
  //
  // `not_found_handling` fica no padrão (404). Em modo SPA o roteador de assets
  // devolveria index.html para QUALQUER caminho sem asset — inclusive /api/* e
  // /webhook/*, que passariam a responder HTML. Por isso a navegação do painel
  // usa rotas em hash (#/funil), que nunca chegam ao servidor.
  "assets": {
    "directory": "./public"
  },

  /*
   * Identificadores do Cloudflare Access, usados para conferir o JWT assinado
   * que ele injeta em cada request (src/lib/access.ts).
   *
   * Não são segredo — o AUD identifica a aplicação, não autentica ninguém, e o
   * domínio da organização aparece na própria tela de login. Ficam aqui, e não
   * em `secret`, porque precisam viajar com a config: um deploy sem eles deixa
   * o painel fora do ar em vez de aberto, que é o lado certo para errar.
   */
  "vars": {
    "ACCESS_TEAM_DOMAIN": "faculdade-ide.cloudflareaccess.com",
    "ACCESS_AUD": "f1ed21ed42bdda4343da59bfdf82d9c9ec09ea7498bed96e4b2d0b229707e3c0",

    /*
     * Segundo nível de acesso: quem pode abrir Funis e webhooks.
     *
     * O Access libera o domínio inteiro da faculdade, o que está certo para
     * relatório. Esta tela é outra coisa — ela EMITE credencial de escrita no
     * banco, e ver o resultado não é a mesma autorização que criar a chave que
     * grava o resultado.
     *
     * Fica em config, versionado, porque muda pouco e assim toda alteração
     * aparece no histórico com autor e data. Lista vazia = ninguém administra;
     * nunca "todo mundo".
     */
    "ADMINS": "nousdynamicslta@gmail.com"
  },

  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dash-ide",
      // D1 da conta Nathalia@faculdadeide.edu.br (25e749043ce433036240369c6fd2b981),
      // a mesma usada pelo Workers Builds. Região primária: enam.
      "database_id": "952edba7-5255-407a-bc60-6154097d3f8a",
      "migrations_dir": "migrations"
    }
  ],

  // Reconciliação diária: catálogo de cursos + etapas reais do Rubeus.
  // Webhooks continuam sendo a fonte em tempo real.
  "triggers": {
    "crons": ["0 9 * * *"]
  }

  // Secrets (NÃO declarar aqui — usar `npx wrangler secret put <NOME>`):
  //   GOOGLE_ADS_* e RD_STATION_CLIENT_ID / RD_STATION_CLIENT_SECRET.
  //   RUBEUS_ORIGEM / RUBEUS_TOKEN / RUBEUS_BASE_URL (opcional).
  //   Localmente vão em .dev.vars (já ignorado pelo git).
  //
  // Os tokens dos webhooks NÃO são secret de Worker: cada um vive numa linha do
  // D1, por funil e por canal, para dar pra revogar um sem derrubar os outros.
}
