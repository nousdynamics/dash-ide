# Copie para `.dev.vars` (ignorado pelo git) antes de rodar `npm run dev`.

# Segredo compartilhado exigido no header X-Webhook-Secret de todo POST vindo de
# Rubeus / n8n / Evolution API.
#
# Produção: gerar com `openssl rand -hex 32` e publicar com
#   npx wrangler secret put WEBHOOK_SECRET
# O MESMO valor precisa ser configurado como header customizado nos três lados.
WEBHOOK_SECRET=""

# --- Google Ads ---
# O Worker consulta a API ao vivo (o n8n não alimenta estes números).
# Em produção: `npx wrangler secret bulk <arquivo.json>`.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID é a conta de anúncios em si, não um MCC.
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_REFRESH_TOKEN=""
GOOGLE_ADS_API_VERSION="v24"
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# --- RD Station ---
# Credenciais do App criado na RD Station App Store. O refresh_token NÃO vem
# daqui: é obtido pelo fluxo em /oauth/rdstation/iniciar e guardado no D1.
RD_STATION_CLIENT_ID=""
RD_STATION_CLIENT_SECRET=""

# --- Rubeus CRM ---
# Canal de API (origem + token). Base opcional; padrão: crmide.apprubeus.com.br
RUBEUS_ORIGEM="222"
RUBEUS_TOKEN=""
RUBEUS_BASE_URL="https://crmide.apprubeus.com.br"

# Libera o painel em `wrangler dev`, onde não há Cloudflare Access na frente.
# NUNCA publicar como secret: em produção a ausência desta variável é o que
# obriga o Worker a exigir o JWT assinado do Access.
AMBIENTE="dev"

# Em dev o usuário é sempre dev@local; sem isto, a tela de Funis e webhooks
# devolve 403 na sua própria máquina.
ADMINS="dev@local"
